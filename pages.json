{
  "easycom": {
    "autoscan": true,
    "custom": {
      "^uni-(.*)": "@dcloudio/uni-ui/lib/uni-$1/uni-$1.vue"
    }
  },
  "pages": [
    {
      "path": "pages/index/index",
      "style": {
        "navigationBarTitleText": "声泊电台",
        "navigationStyle": "custom"
      }
    },
    {
      "path": "pages/radio/radio",
      "style": {
        "navigationBarTitleText": "声泊电台",
        "navigationStyle": "default"
      }
    },
    {
      "path": "pages/tv/tv",
      "style": {
        "navigationBarTitleText": "电视",
        "navigationStyle": "default"
      }
    },
    {
      "path": "pages/search/search",
      "style": {
        "navigationBarTitleText": "搜索电台",
        "navigationStyle": "default"
      }
    },
    {
      "path": "pages/player/player",
      "style": {
        "navigationBarTitleText": "播放器",
        "navigationStyle": "default"
      }
    }
  ],
  "tabBar": {
    "color": "#999999",
    "selectedColor": "#007AFF",
    "borderStyle": "black",
    "backgroundColor": "#ffffff",
    "list": [
      {
        "pagePath": "pages/radio/radio",
        "text": "电台",
        "iconPath": "/static/tabbar/radio.png",
        "selectedIconPath": "/static/tabbar/radio-active.png"
      },
      {
        "pagePath": "pages/tv/tv",
        "text": "电视",
        "iconPath": "/static/tabbar/tv.png",
        "selectedIconPath": "/static/tabbar/tv-active.png"
      }
    ]
  },
  "globalStyle": {
    "navigationBarTextStyle": "black",
    "navigationBarTitleText": "声泊电台",
    "navigationBarBackgroundColor": "#F8F8F8",
    "backgroundColor": "#F8F8F8"
  }
}
